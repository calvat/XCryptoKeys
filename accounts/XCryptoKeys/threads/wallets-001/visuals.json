 "41": {
  "type": "formula",
  "k": "Nonce reuse",
  "expr": "k = (z1 − z2) / (s1 − s2)",
  "terms": [
   {
    "k": "Signing",
    "v": "s = k⁻¹(z + r·d)"
   },
   {
    "k": "Then",
    "v": "solve for the private key **d**"
   },
   {
    "k": "Fix",
    "v": "RFC 6979: k derived from key + message"
   }
  ],
  "foot": "fail0verflow, 2010: Sony's PS3 key, static k"
 },
