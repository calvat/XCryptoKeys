  "15": {
    "type": "steps",
    "steps": [
      {
        "label": "Walk the committee"
      },
      {
        "label": "Sum the power of committers not absent"
      },
      {
        "label": "Require ≥ 2f+1 of committee power",
        "sub": "f = (n − 1) / 3"
      },
      {
        "label": "Aggregate the signers' public keys"
      },
      {
        "label": "Verify the one signature",
        "hl": true
      }
    ],
    "note": {
      "k": "Signature checks",
      "v": "Exactly 1, whatever the committee size"
    }
  },
