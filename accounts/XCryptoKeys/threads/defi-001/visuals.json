 "28": {
  "type": "formula",
  "k": "StableSwap (Egorov, 2019)",
  "expr": "A·nⁿ·Σxᵢ + D = A·D·nⁿ + Dⁿ⁺¹ / (nⁿ·Πxᵢ)",
  "terms": [
   {
    "k": "D",
    "v": "total when all coins are at par"
   },
   {
    "k": "Near balance",
    "v": "like constant **sum**: flat"
   },
   {
    "k": "Far from balance",
    "v": "like constant product"
   }
  ]
 },
